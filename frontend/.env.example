# Base URL of the CareerOS backend API.
VITE_API_BASE_URL=http://localhost:5000

# Optional. URL of an exported Spline scene for the homepage hero.
# When unset, the hero shows a polished HTML fallback (no Spline runtime is
# loaded). To enable the 3D hero, publish a scene in the Spline editor and
# paste its runtime URL here, e.g.:
#   VITE_SPLINE_SCENE_URL=https://prod.spline.design/XXXXXXXX/scene.splinecode
VITE_SPLINE_SCENE_URL=
